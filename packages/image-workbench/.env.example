# 独立服务配置示例。不包含真实密钥；不要连接源项目或宿主的生产数据库。
HOST=127.0.0.1
PORT=3010
DATABASE_URL=postgresql://workbench:replace_me@127.0.0.1:5432/image_workbench
DATA_DIR=./data
INITIAL_ADMIN_ACCOUNT_ID=workbench_admin
# 必填：10–200 位且包含字母和数字（建议至少 12 位）；首次登录强制修改。
INITIAL_ADMIN_PASSWORD=

# 必填：自己的 HTTPS 图像网关及服务端凭据。
APIYI_BASE_URL=
APIYI_API_KEY=
# 可选：按网关实际支持的模型覆盖默认值。
# APIYI_GPT_IMAGE_GENERATION_MODEL=
# APIYI_GPT_IMAGE_EDIT_MODEL=
# IMAGE_CONVERSATION_PLANNER_MODEL=
# SCENE_ANALYSIS_MODEL=

# 仅本机 HTTP 调试为 false；HTTPS 部署必须设为 true。
COOKIE_SECURE=false
# DWPose 与深度估计为可选辅助服务；未配置时相应自动分析不可用。
# POSE_SERVICE_URL=
# POSE_SERVICE_TOKEN=
# DEPTH_SERVICE_URL=
# DEPTH_SERVICE_TOKEN=
