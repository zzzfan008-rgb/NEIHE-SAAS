{
  "name": "@garment-canvas/image-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable original React/TypeScript + Node/Express image workbench; no host adapter",
  "engines": { "node": ">=22.20.0" },
  "packageManager": "pnpm@11.19.0",
  "exports": {
    "./react": { "types": "./dist-types/react/index.d.ts", "import": "./dist/react.js" },
    "./server": { "types": "./dist-types/server/app.d.ts", "import": "./dist-server/app.js" },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": ["**/*.css"],
  "files": ["react", "src", "server", "dist", "dist-server", "dist-types", "docs", "tests", "scripts", "templates", "provenance.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "compose.test.yaml", "tsconfig*.json", "vite.config.ts", ".env.example", "README.md"],
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "npm run lint && vite build && tsc -p tsconfig.types.json && node scripts/build-server.mjs",
    "start": "node dist-server/cli.js",
    "test": "node scripts/test-with-postgres.mjs",
    "test:suite": "node scripts/test-suite.mjs",
    "test:package": "node --test tests/package.test.mjs",
    "check": "npm run lint && npm run test",
    "prepack": "npm run build && npm run test:package"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "dependencies": {
    "@base-ui/react": "^1.7.0", "@xyflow/react": "^12.3.6",
    "better-sqlite3": "^13.0.3", "class-variance-authority": "^0.7.1", "clsx": "^2.1.1",
    "express": "^4.21.2", "konva": "10.3.2", "lucide-react": "^1.33.0", "nanoid": "^5.1.0",
    "pg": "^8.23.0", "react-konva": "19.2.5", "saxes": "6.0.0", "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0", "three": "0.186.0", "undici": "^7.29.0", "yauzl": "3.4.0",
    "zundo": "^2.2.0", "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3", "@types/better-sqlite3": "^9.6.0", "@types/express": "^4.17.21",
    "@types/node": "^22.10.0", "@types/pg": "^8.21.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0", "@types/yauzl": "3.4.0", "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2", "react": "^19.0.0", "react-dom": "^19.0.0", "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3", "tsx": "^4.19.0", "tw-animate-css": "^1.4.0", "typescript": "^5.7.0", "vite": "^6.0.0"
  }
}
