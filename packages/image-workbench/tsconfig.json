{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "isolatedModules": true, "noEmit": true,
    "noFallthroughCasesInSwitch": true, "types": ["node", "vite/client"]
  },
  "include": ["react", "src", "server", "vite.config.ts"]
}
