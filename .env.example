# API易图片接口（模型、路径和参数由 docs/ai/apiyi/model-contracts.json 管理）
APIYI_BASE_URL=https://api.apiyi.com
APIYI_API_KEY=sk-your-apiyi-key

# Seedance 视频接口（独立于图片 API，需兼容 /seedance/api/v3 异步协议）
SEEDANCE_API_BASE_URL=https://api.apiyi.com
SEEDANCE_API_KEY=sk-your-seedance-key
# 本地视频转存为 Seedance 可访问 HTTPS 地址时使用的 icover.ai 素材库凭据
SEEDANCE_ASSET_API_BASE_URL=https://icover.ai/api
SEEDANCE_ASSET_API_KEY=sk-your-seedance-asset-key

# 服务端口
PORT=3001
# Vite 开发服务的 /api 代理默认跟随 PORT；只有转发到其他地址时才需要显式配置
# API_PROXY_TARGET=http://localhost:3001

# 数据目录（项目/上传文件）
DATA_DIR=./data

# Docker 内置 PostgreSQL 18（密码必须放在私有 .env，不要提交）
POSTGRES_DB=garment_canvas
POSTGRES_USER=garment_canvas
POSTGRES_PASSWORD=replace-with-a-long-random-password
# 仅暴露给本机开发服务，Docker 内的应用仍直连 5432
POSTGRES_HOST_PORT=54329
# 连接池上限（可选）
DATABASE_POOL_SIZE=10

# 首次启动管理员（仅数据库还没有用户时使用；密码首次登录后必须修改）
INITIAL_ADMIN_ACCOUNT_ID=replace-with-admin-account
INITIAL_ADMIN_PASSWORD=replace-with-temporary-password

# 升级时要导入的旧 SQLite 文件（相对于 DATA_DIR）
# PostgreSQL 为空时只读导入一次，原文件保留不变
SQLITE_IMPORT_FILE=garment-canvas.db

# 内网 HTTP 部署保持 false；启用 HTTPS 反向代理后改为 true
COOKIE_SECURE=false

# 仅启动 API、不托管 dist 前端（完整部署保持 false）
API_ONLY=false

# AI 调用总时限（毫秒；未设置时使用各模型知识库默认值）
# AI_TIMEOUT_MS=300000
# TCP/TLS 建连、响应头、响应体空闲时限；后三者均不会超过总时限
# AI_CONNECT_TIMEOUT_MS=30000
# AI_HEADERS_TIMEOUT_MS=300000
# AI_BODY_TIMEOUT_MS=300000
# chunked JSON 已完整但连接迟迟不收尾时的主动回收等待窗口
# AI_IMAGE_TAIL_GRACE_MS=5000

# 第一轮场景/构图/光线/姿态/神态视觉分析模型（只返回结构化文字）
SCENE_ANALYSIS_MODEL=gemini-3-flash-preview
# 换装候选图视觉评分模型（标准 /v1/chat/completions 视觉消息）
TRY_ON_JUDGE_MODEL=gemini-3-flash-preview
# 人物脸部边界定位模型；失败时只做本地保守裁切
IDENTITY_ANALYSIS_MODEL=gemini-3-flash-preview

# Generation worker poll interval (ms), default 2000; range 100-60000
GENERATION_WORKER_POLL_MS=2000

# 429、确认可重试的 503、IMAGE_SAFETY、超时和连接中断由 PostgreSQL Worker 最多自动重试 2 次
# （含首次请求最多 3 次真实请求）；参数错误、确定审核拒绝和损坏响应不重试。
